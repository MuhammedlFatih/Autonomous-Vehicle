<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="car">

    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>

    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <link name="base_link"/>

    <joint name="base_link_connection" type="fixed">
        <parent link="base_link" />
        <child link="chassis" />
        <origin xyz="0.0 0 0" rpy="0 0 0.0" />
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${pi/2}"/>
            <geometry>
                <mesh filename="file://$(find four_wheel_car)/meshes/golf_car.dae"/>
            </geometry>
            <material name="white"/>
       </visual>
       <collision>
            <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 ${pi/2}"/>
            <geometry>
                <box size="0.7 0.3 0.4"/>
            </geometry>
       </collision>
       <xacro:inertial_box mass="5" x="1.0" y="0.4" z="0.0" xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${pi/2}"/> 
    </link>

    <link name="fl_axle">
        <xacro:inertial_box mass="0.1" x="0.04" y="0.04" z="0.04" xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/> 
    </link>

    <link name="fr_axle">
        <xacro:inertial_box mass="0.1" x="0.04" y="0.04" z="0.04" xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/> 
    </link>

    <link name="front_left_wheel">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 ${pi/2}"/>
            <geometry>
                <mesh filename="file://$(find four_wheel_car)/meshes/wheel.dae"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.175" length="0.15"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.5" radius="0.175" length="0.15" xyz="0 0 0" rpy="${pi/2} 0 0"/>
    </link>

    <link name="front_right_wheel">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 ${pi*3/2}"/>
            <geometry>
               <mesh filename="file://$(find four_wheel_car)/meshes/wheel.dae"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.175" length="0.15"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.8" radius="0.175" length="0.15" xyz="0 0 0" rpy="${pi/2} 0 0"/>
    </link>

    <link name="rear_left_wheel">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 ${pi/2}"/>
            <geometry>
                <mesh filename="file://$(find four_wheel_car)/meshes/wheel.dae"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.175" length="0.15"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.8" radius="0.175" length="0.15" xyz="0 0 0" rpy="${pi/2} 0 0"/>
    </link>

    <link name="rear_right_wheel">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 ${pi*3/2}"/>
            <geometry>
                <mesh filename="file://$(find four_wheel_car)/meshes/wheel.dae"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.175" length="0.15"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.8" radius="0.175" length="0.15" xyz="0 0 0" rpy="${pi/2} 0 0"/>
    </link>

    <joint name="front_left_steer_joint" type="revolute">
        <origin xyz="0.70 0.4 0.03" rpy="0.0 0.0 0.0"/>
        <parent link="chassis"/>
        <child link="fl_axle"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-0.785" upper="0.785" effort="10000000.0" velocity="10000000.0"/>
    </joint>

    <joint name="front_right_steer_joint" type="revolute">
        <origin xyz="0.70 -0.4 0.03" rpy="0.0 0.0 0.0"/>
        <parent link="chassis"/>
        <child link="fr_axle"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-0.785" upper="0.785" effort="10000000.0" velocity="10000000.0"/>
    </joint>

    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="fl_axle" />
        <child link="front_left_wheel" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="fr_axle" />
        <child link="front_right_wheel" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="rear_left_wheel_joint" type="continuous">
        <origin xyz="-0.60 0.4 0.03" rpy="0.0 0.0 0.0"/>
        <parent link="chassis" />
        <child link="rear_left_wheel" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="rear_right_wheel_joint" type="continuous">
        <origin xyz="-0.60 -0.4 0.03" rpy="0.0 0.0 0.0"/>
        <parent link="chassis" />
        <child link="rear_right_wheel" />
        <axis xyz="0 1 0" />
    </joint>

    <gazebo reference="chassis">
        <material>Gazebo/Yellow</material>
    </gazebo>

    <gazebo reference="front_left_wheel">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="front_right_wheel">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="rear_left_wheel">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="rear_right_wheel">
        <material>Gazebo/Black</material>
    </gazebo>

</robot>
